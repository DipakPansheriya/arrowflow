rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ArrowFlow TOTP config: allow read/write with the API key
    // (no user auth required — the EXE uses the web API key directly)
    match /arrowflow_config/totp_auth {
      allow read, write: if true;
    }
    
    // Block all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
